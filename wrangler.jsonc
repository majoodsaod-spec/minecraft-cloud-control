{
  "name": "minecraft-cloud-control",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MC_BRIDGE",
        "class_name": "MinecraftBridge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MinecraftBridge"
      ]
    }
  ]
}
