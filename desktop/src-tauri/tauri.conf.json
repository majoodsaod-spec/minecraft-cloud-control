{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Cloud",
  "version": "0.1.0",
  "identifier": "com.minecraftcloud.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Minecraft Cloud",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "backgroundColor": "#F4F5F7",
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
